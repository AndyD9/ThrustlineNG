{
  "schemaVersion": 1,
  "policy": {
    "clientTrust": "untrusted",
    "mutationRule": "server-command-only",
    "serviceOnlyCommands": [
      "create_company_with_opening_balance",
      "create_dispatch_draft",
      "finalize_account_deletion",
      "post_company_opening_balance",
      "purchase_aircraft",
      "replay_account_deletion_event"
    ],
    "clientDataApiReads": [
      {
        "path": "apps/desktop/src/features/aircraft-catalog/aircraftCatalog.ts",
        "resource": "aircraft_purchase_offers"
      },
      {
        "path": "apps/desktop/src/features/company-state/companyState.ts",
        "resource": "companies"
      },
      {
        "path": "apps/desktop/src/features/aircraft-fleet/aircraftFleet.ts",
        "resource": "company_aircraft"
      }
    ]
  },
  "clientSurfaces": [
    {
      "id": "desktop-webview",
      "path": "apps/desktop/src",
      "sourceExtensions": [".ts", ".tsx"],
      "nonExecutableExtensions": [".css"],
      "excludedDirectories": []
    },
    {
      "id": "desktop-tauri",
      "path": "apps/desktop/src-tauri/src",
      "sourceExtensions": [".rs"],
      "nonExecutableExtensions": [],
      "excludedDirectories": []
    },
    {
      "id": "local-bridge",
      "path": "apps/bridge",
      "sourceExtensions": [".cs"],
      "nonExecutableExtensions": [".csproj", ".json"],
      "excludedDirectories": ["bin", "obj"]
    }
  ],
  "domains": [
    {
      "id": "identity",
      "status": "external-authority",
      "coverage": "managed",
      "serverBoundaries": ["Supabase Auth"],
      "evidencePaths": [
        "apps/desktop/src/features/auth/passwordSignIn.ts",
        "apps/desktop/src/features/auth/session.ts",
        "supabase/config.toml"
      ],
      "evidenceMarkers": ["/auth/v1/token?grant_type=password", "/auth/v1/token?grant_type=refresh_token", "[auth]", "enabled = true"],
      "limitations": ["The desktop has local-only email/password acquisition and in-memory refresh foundations behind injected components. T0040 enables a provisioned local identity and runtime validation, but no routed composition, persisted session, remote target or production call is implemented."]
    },
    {
      "id": "company",
      "status": "server-authoritative",
      "coverage": "partial",
      "serverBoundaries": [
        "supabase/functions/company-onboarding/handler.ts",
        "public.create_company_with_opening_balance"
      ],
      "evidencePaths": [
        "apps/desktop/src/features/company-state/companyState.ts",
        "supabase/functions/company-onboarding/handler.ts",
        "supabase/migrations/20260731000400_authoritative_company_onboarding.sql",
        "supabase/tests/database/company_onboarding.test.sql"
      ],
      "evidenceMarkers": ["rest/v1/companies", "createCompanyOnboardingHandler", "create_company_with_opening_balance"],
      "limitations": ["Creation, deletion and a bounded owner-presence read are covered; later company profile mutations are not designed."]
    },
    {
      "id": "account-lifecycle",
      "status": "server-authoritative",
      "coverage": "partial",
      "serverBoundaries": [
        "public.request_account_deletion",
        "public.cancel_account_deletion",
        "public.finalize_account_deletion"
      ],
      "evidencePaths": [
        "supabase/migrations/20260731000100_account_lifecycle.sql",
        "supabase/tests/database/account_lifecycle.test.sql"
      ],
      "evidenceMarkers": ["request_account_deletion", "cancel_account_deletion", "finalize_account_deletion"],
      "limitations": ["Only synthetic local and CI data are admitted."]
    },
    {
      "id": "fleet",
      "status": "server-authoritative",
      "coverage": "partial",
      "serverBoundaries": [
        "supabase/functions/aircraft-purchase/handler.ts",
        "public.purchase_aircraft"
      ],
      "evidencePaths": [
        "apps/desktop/src/features/aircraft-catalog/aircraftCatalog.ts",
        "apps/desktop/src/features/aircraft-fleet/aircraftFleet.ts",
        "apps/desktop/src/features/aircraft-purchase/aircraftPurchase.ts",
        "supabase/functions/aircraft-purchase/handler.ts",
        "supabase/migrations/20260802000100_authoritative_aircraft_purchase.sql",
        "supabase/tests/database/aircraft_purchase.test.sql"
      ],
      "evidenceMarkers": ["rest/v1/aircraft_purchase_offers", "rest/v1/company_aircraft", "functions/v1/aircraft-purchase", "createAircraftPurchaseHandler", "purchase_aircraft", "company_aircraft"],
      "limitations": ["Bounded catalogue, purchase and owner-fleet reads are composed behind explicit user actions; live desktop connectivity and deployment are not provided, and lease or later fleet mutations are not implemented."]
    },
    {
      "id": "dispatch",
      "status": "server-authoritative",
      "coverage": "partial",
      "serverBoundaries": [
        "public.create_dispatch_draft"
      ],
      "evidencePaths": [
        "supabase/migrations/20260803000100_authoritative_dispatch_draft.sql",
        "supabase/tests/database/dispatch_draft.test.sql"
      ],
      "evidenceMarkers": [
        "create_dispatch_draft",
        "flight_dispatches",
        "owner A cannot dispatch owner B aircraft"
      ],
      "limitations": ["Only a server-created, idempotent draft with an owned aircraft and two normalized ICAO codes is covered; no authenticated endpoint, desktop composition, SimBrief preparation, lifecycle transition, flight runtime or financial impact is implemented."]
    },
    {
      "id": "flight-runtime",
      "status": "not-implemented",
      "coverage": "none",
      "serverBoundaries": [],
      "evidencePaths": ["docs/CURRENT_STATE.md"],
      "limitations": ["The replay adapter emits samples but no flight state is persisted or mutated."]
    },
    {
      "id": "flight-finalization",
      "status": "not-implemented",
      "coverage": "none",
      "serverBoundaries": [],
      "evidencePaths": ["docs/CURRENT_STATE.md"],
      "limitations": ["No versioned flight report or idempotent finalization command exists."]
    },
    {
      "id": "finance",
      "status": "server-authoritative",
      "coverage": "partial",
      "serverBoundaries": [
        "public.post_company_opening_balance",
        "supabase/functions/aircraft-purchase/handler.ts",
        "public.purchase_aircraft"
      ],
      "evidencePaths": [
        "apps/desktop/src/features/aircraft-catalog/aircraftCatalog.ts",
        "apps/desktop/src/features/aircraft-purchase/aircraftPurchase.ts",
        "eng/economy-policy.json",
        "supabase/migrations/20260731000300_immutable_financial_ledger.sql",
        "supabase/tests/database/financial_ledger.test.sql",
        "supabase/functions/aircraft-purchase/handler.ts",
        "supabase/migrations/20260802000100_authoritative_aircraft_purchase.sql",
        "supabase/tests/database/aircraft_purchase.test.sql"
      ],
      "evidenceMarkers": ["rest/v1/aircraft_purchase_offers", "functions/v1/aircraft-purchase", "new-company-opening", "post_company_opening_balance", "createAircraftPurchaseHandler", "purchase_aircraft"],
      "limitations": ["Opening, bounded authenticated catalogue read and one-off aircraft purchase are covered as separate components; routed composition, live connectivity, recurring lease and other financial commands are not defined."]
    },
    {
      "id": "reputation-progression",
      "status": "not-implemented",
      "coverage": "none",
      "serverBoundaries": [],
      "evidencePaths": ["docs/CURRENT_STATE.md"],
      "limitations": ["Reputation and progression mutations are not implemented."]
    },
    {
      "id": "maintenance",
      "status": "not-implemented",
      "coverage": "none",
      "serverBoundaries": [],
      "evidencePaths": ["docs/CURRENT_STATE.md"],
      "limitations": ["Maintenance state and costs are not implemented."]
    },
    {
      "id": "passive-operations",
      "status": "not-implemented",
      "coverage": "none",
      "serverBoundaries": [],
      "evidencePaths": ["docs/CURRENT_STATE.md"],
      "limitations": ["Schedules, rotations and temporal jobs are not implemented."]
    },
    {
      "id": "data-continuity",
      "status": "server-authoritative",
      "coverage": "partial",
      "serverBoundaries": [
        "public.replay_account_deletion_event"
      ],
      "evidencePaths": [
        "supabase/migrations/20260731000200_account_deletion_restore_replay.sql",
        "supabase/tests/database/account_restore_replay.test.sql"
      ],
      "evidenceMarkers": ["replay_account_deletion_event"],
      "limitations": ["Managed encrypted backup, Vault/Storage restore, production promotion and signed updater rollback are absent."]
    },
    {
      "id": "distribution",
      "status": "not-implemented",
      "coverage": "none",
      "serverBoundaries": [],
      "evidencePaths": ["docs/CURRENT_STATE.md"],
      "limitations": ["Signed update, rollback and uninstall data-preservation proof are not implemented."]
    }
  ],
  "goldenPath": [
    { "step": 1, "id": "account-and-company", "domains": ["identity", "company", "account-lifecycle"] },
    { "step": 2, "id": "create-company", "domains": ["company"] },
    { "step": 3, "id": "acquire-aircraft", "domains": ["fleet", "finance"] },
    { "step": 4, "id": "prepare-dispatch", "domains": ["dispatch"] },
    { "step": 5, "id": "track-flight", "domains": ["flight-runtime"] },
    { "step": 6, "id": "resume-flight", "domains": ["flight-runtime", "data-continuity"] },
    { "step": 7, "id": "finalize-flight-once", "domains": ["flight-finalization", "finance"] },
    { "step": 8, "id": "apply-flight-impacts", "domains": ["finance", "reputation-progression", "maintenance"] },
    { "step": 9, "id": "plan-passive-operations", "domains": ["passive-operations"] },
    { "step": 10, "id": "update-or-uninstall-safely", "domains": ["data-continuity", "distribution"] }
  ]
}
