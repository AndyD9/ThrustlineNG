{
  "name": "@thrustline/desktop",
  "version": "0.1.0-alpha.1",
  "private": true,
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:frontend": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "pnpm typecheck && vite build",
    "check": "pnpm typecheck && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo check --manifest-path src-tauri/Cargo.toml --locked && cargo clippy --manifest-path src-tauri/Cargo.toml --locked -- -D warnings",
    "test": "pnpm test:frontend && cargo test --manifest-path src-tauri/Cargo.toml --locked && powershell -NoProfile -ExecutionPolicy Bypass -File ../../tests/desktop-shell/run.ps1"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
