{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thrustline",
  "version": "0.0.0",
  "identifier": "com.thrustline.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thrustline",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "transparent": false,
        "decorations": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
