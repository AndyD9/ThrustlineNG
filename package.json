{
  "name": "thrustline-ng",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "desktop:dev": "pnpm --dir apps/desktop tauri dev",
    "desktop:check": "pnpm --dir apps/desktop check",
    "desktop:test": "pnpm --dir apps/desktop test",
    "desktop:build": "pnpm --dir apps/desktop tauri build --no-bundle",
    "desktop:measure": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/measure-tauri-shell.ps1 -OutputDirectory ./artifacts/t0007",
    "frontend:dev": "pnpm --dir apps/desktop dev",
    "frontend:typecheck": "pnpm --dir apps/desktop typecheck",
    "frontend:test": "pnpm --dir apps/desktop test:frontend",
    "frontend:coverage": "pnpm --dir apps/desktop coverage",
    "frontend:build": "pnpm --dir apps/desktop build",
    "frontend:measure": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/measure-frontend.ps1 -OutputDirectory ./artifacts/t0008",
    "bridge:build": "dotnet build ThrustlineNG.slnx --configuration Release",
    "bridge:test": "dotnet run --project tests/bridge/Thrustline.Bridge.Tests.csproj --configuration Release",
    "bridge:health": "dotnet run --project apps/bridge/Thrustline.Bridge.csproj --configuration Release -- --health-check",
    "bridge:publish": "dotnet publish apps/bridge/Thrustline.Bridge.csproj --configuration Release --runtime win-x64 --self-contained true",
    "performance:test": "pwsh -NoProfile -File ./tests/performance-budgets/run.ps1",
    "performance:measure:bridge": "pwsh -NoProfile -File ./scripts/measure-bridge.ps1 -OutputDirectory ./artifacts/t0015",
    "performance:check": "pwsh -NoProfile -File ./scripts/check-performance-budgets.ps1",
    "performance:check:build": "pwsh -NoProfile -File ./scripts/check-performance-budgets.ps1 -BuiltArtifacts",
    "windows:package:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/windows-package/run.ps1",
    "windows:package": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-windows-package.ps1 -OutputDirectory ./artifacts/t0014/package",
    "windows:package:test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-windows-package.ps1 -PackageDirectory ./artifacts/t0014/package -ValidationDirectory ./artifacts/t0014/validation",
    "ci:check": "pwsh -NoProfile -File ./tests/ci/run.ps1",
    "ci:backend": "pwsh -NoProfile -File ./scripts/ci/test-backend.ps1",
    "supply-chain:report": "pwsh -NoProfile -File ./scripts/ci/write-license-report.ps1 -OutputDirectory ./artifacts/supply-chain",
    "backend:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/backend/run.ps1",
    "backend:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-supabase-local.ps1",
    "backend:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/invoke-supabase-local.ps1 -Action Stop",
    "backend:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/invoke-supabase-local.ps1 -Action Reset",
    "backend:test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/invoke-supabase-local.ps1 -Action Test",
    "backend:functions:test": "node --test ./supabase/functions/company-onboarding/handler.test.ts ./supabase/functions/aircraft-purchase/handler.test.ts ./supabase/functions/dispatch-draft/handler.test.ts",
    "backend:types": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-database-types.ps1",
    "backend:types:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-database-types.ps1 -Check",
    "data-policy:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/data-policy/run.ps1",
    "authority:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/authority/run.ps1",
    "maintenance:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/maintenance/run.ps1"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "devDependencies": {
    "supabase": "2.109.1"
  }
}
